# Expo/EAS Configuration
# Get your EXPO_PROJECT_ID from https://expo.dev/projects
EXPO_PROJECT_ID=

# Application Identity
# This should match the bundleIdentifier in app.config.ts
VITE_APP_ID=space.manus.max.seg.apiahy.t20260910020105
EXPO_PUBLIC_APP_ID=space.manus.max.seg.apiahy.t20260910020105

# OAuth & Authentication
# Configure these URLs for your authentication server
VITE_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_PORTAL_URL=

OAUTH_SERVER_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=

# Owner Information
# Configure these with your app's owner details
OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=

OWNER_NAME=
EXPO_PUBLIC_OWNER_NAME=

# Development Environment
NODE_ENV=development

# Android Signing Configuration (for EAS build)
# These are configured via Expo Dashboard in production
# Local testing: https://docs.expo.dev/app-signing/local-credentials/

# iOS Signing Configuration (for EAS build)
# These are configured via Expo Dashboard in production
# Requires Apple Developer Account and certificates
